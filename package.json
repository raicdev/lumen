{
  "name": "lumen",
  "version": "0.2.1",
  "private": true,
  "description": "Lumen — a fast, beautiful code editor. Zed alternative built with Lumen Shell, Node.js & TypeScript.",
  "type": "module",
  "scripts": {
    "start": "lumen-shell dev",
    "dev": "lumen-shell dev --watch",
    "build": "lumen-shell build",
    "package": "lumen-shell package",
    "installer": "lumen-shell installer",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" \"test/features/*.test.ts\"",
    "ext:transpile": "node src/main/extensions/cli.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.1",
    "@lumen/shell": "workspace:*",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@replit/codemirror-minimap": "^0.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1",
    "lucide-react": "^1.59.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.8.2",
    "vscode-json-languageservice": "^5.7.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "koffi",
      "node-pty"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
